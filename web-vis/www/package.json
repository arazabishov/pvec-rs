{
  "name": "pvec-web-vis",
  "version": "0.1.0",
  "description": "Interactive RRB-Tree visualization for pvec-rs",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production --config webpack.config.js",
    "start": "webpack-dev-server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArazAbishov/pvec-rs.git"
  },
  "keywords": [
    "rrb-tree",
    "persistent-vector",
    "visualization",
    "webassembly"
  ],
  "author": "Araz Abishov <araz@abishov.com>",
  "license": "MIT",
  "dependencies": {
    "d3": "^7.9.0",
    "lucide": "^0.563.0",
    "web-vis": "file:../pkg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "css-loader": "^7.1.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "html-webpack-plugin": "^5.6.6",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.8.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "homepage": "https://pvec-rs.abishov.com/web-vis/"
}
